<ParameterList name="SCI">
    <ParameterList name="Parameter">
        <Parameter name="Dimension" type="int" value="3"/>
        <Parameter name="Discretization" type="string" value="P2"/><!--P2-->
        <Parameter name="BC Type" type="string" value="Artery"/><!--Plaque (Artery_dan_SCI.mesh) or Artery (artery_h_0_8_L_0_25_clean.mesh)-->
        <Parameter name="RHS Type" type="string" value="Constant"/><!--Constant, Paper, Heart Beat-->
        
		<Parameter name="Mesh Type" type="string" value="unstructured"/> <!--  structured, unstructured -->
        <Parameter name="H/h" type="int" value="1"/> <!-- only relevant for structured meshes -->
    
        <Parameter name="Pressure" type="double" value="12.95131763460572"/> <!-- Load applied on interior wall. Equates to 97.14 mmHg and hence results in 85mmHg(0.875 times) -->
        <Parameter name="Source Type" type="string"   value="surface"/>
        <Parameter name="Model Geometry" type="string" value="Laplace"/>
        
        <Parameter name="SCI" type="bool" value="true"/>
        <Parameter name="Chemistry Explicit" type="bool" value="false"/>
        <Parameter name="Load Stepping" type="bool" value="true"/>
        <Parameter name="Inflow Start Time" type="double" value="10000000.0"/><!-- Start of diffusion process -->
        <Parameter name="Heart Beat Start" type="double" value="70000000.0"/><!-- Start of heart beat -->
        <Parameter name="Load Step Size" type="double" value="0.05"/><!-- Length/size of Loadsteps -->
        <Parameter name="Ramp End Time" type="double" value="1.0"/><!-- End of Load Stepping -->
        <Parameter name="External Force" type="bool" value="true"/>
        <Parameter name="Nonlinear External Force" type="bool" value="true"/>
        <Parameter name="Coupling Type" type="string" value="implicit"/>
        <Parameter name="Accelerated Active Until" type="double" value="220.0"/>
        <Parameter name="Active Acceleration Multiplier" type="double" value="20.0"/>

       
        <Parameter name="relNonLinTol" type="double" value="1.0e-7"/>
        <Parameter name="absNonLinTol" type="double" value="1.0e-7"/>
        <Parameter name="updateTol" type="double" value="1.0e-7"/>
        <Parameter name="Combo" type="string" value="OR"/>
        <Parameter name="Use update tol" type="bool" value="true"/>
        <Parameter name="Use WRMS" type="bool" value="false"/>
        
        <Parameter name="MaxNonLinIts" type="int" value="5"/>

        <Parameter name="Criterion" type="string" value="Update"/><!-- Criterion for nonlinear solve, Residual or Update: Residual is the norm of the nonlinear residual; Update is the norm of the update -->
    </ParameterList>

    <ParameterList name="Mesh Partitioner">
        <Parameter name="Contiguous" type="bool" value="true"/>
        
        <Parameter name="Mesh 1 Name" type="string" value="artery_h_0_8_L_0_25_clean.mesh"/> <!-- a quarter of a short artery segment: sci_Test's mesh without its two unused vertices on the axis -->
        
        <Parameter name="Automatic partition" type="bool" value="false"/> <!-- find ratio for ranks based on the number of elements of each mesh -->
        
        <Parameter name="Mesh 1 fraction ranks" type="int" value="-1"/> <!-- percentage of ranks for mesh 1; if Automatic partition=true this will be ignored; if set below 0 number of ranks will be used -->
        <Parameter name="Mesh 1 number ranks" type="int" value="-1"/><!-- number of ranks for this mesh; if Automatic partition=true this will be ignored; if fraction ranks>=0 this will be ignored -->
         
    </ParameterList>

    <ParameterList name="Exporter">
        <Parameter name="Write new mesh" type="bool" value="false"/>
        <Parameter name="Export every X timesteps" type="int" value="1"/>
               
        <Parameter name="Export coarse functions" type="bool" value="false"/>
       
        <Parameter name="Name coarse functions block1" type="string" value="phiC"/>
        <Parameter name="Name coarse functions block2" type="string" value="phiD"/>
        <Parameter name="Exclude coarse functions block4" type="bool" value="true"/>
        
    </ParameterList>
    <ParameterList name="General">
        <Parameter name="Mpi Ranks Coarse" type="int" value="0"/>
        <Parameter name="ParaViewExport" type="bool" value="true"/>
        <Parameter name="ParaViewCoarse" type="bool" value="false"/>
        <Parameter name="ExportID" type="int" value="7"/>
        <Parameter name="ParaView export subdomains" type="bool" value="true"/>
        
        <Parameter name="Export Suffix" type="string" value=""/>
        <Parameter name="Export Data" type="bool" value="true"/>
        <Parameter name="Export Extra Data" type="bool" value="false"/>
        <Parameter name="Export drag and lift" type="bool" value="true"/>

        <Parameter name="Export Stress" type="bool" value="true"/>
        <Parameter name="Every X Second" type="double" value="20."/> <!-- Output frequency for stresses and co. during normal phase. 1 = every time step. 10 = every tenth time step -->
        <!-- <Parameter name="Every X Second Heartbeat" type="double" value="0.01"/> --> <!-- Output frequency for stresses and co. during heartbeat phases. Currently no heartbeat rhs -->

        <Parameter name="Preconditioner Method" type="string" value="Monolithic"/> <!-- Monolithic, FaCSI, FaCSI-Teko -->
       
        <Parameter name="Only Diagonal" type="bool" value="false"/>

        <Parameter name="Scale mass matrix" type="bool" value="true"/>
        <Parameter name="Set Zeros" type="bool" value="true"/>
        
        <Parameter name="Linearization" type="string" value="NOX"/> <!-- FixedPoint, Newton, Extrapolation-->
    </ParameterList>
    <ParameterList name="Timestepping Parameter">
        <!-- ctest artery_restart_adaptive: adaptive time stepping with checkpoints. The fixed first load step, then an adaptive segment to 0.1 (MaxNonLinIts 5): its first time step ends at the checkpoint 0.09 instead of 0.1, and the time step from 0.09, which starts by writing that checkpoint, fails and is repeated. The restart from 0.05 must reproduce the uninterrupted run at 0.09. The time steps after 0.1 do not adapt (and are not needed) -->
        <Parameter name="Adaptive Time Stepping" type="bool" value="true"/>
        <!-- Restart test, phase 1 (this file): the uninterrupted run. It writes
             checkpoints at 0.05 (the restart time of phase 2, after the first step of the
             load ramp) and 0.1 (the time phase 2 compares at) to the checkpoint directory. A checkpoint is written at the
             start of the time step after it, so this run ends one step later. -->
        <Parameter name="Checkpointing" type="bool"  value="true"/>
        <Parameter name="Checkpoint directory" type="string" value="restartCheckpoints"/>
        <Parameter name="Checkpoint Times" type="Array(double)" value="{0.05, 0.09}"/>
        <Parameter name="Export history" type="bool"  value="true"/>

        <!-- Restart (phase 2, simulationParameters_restart.xml): from the checkpoint at
             "Time step" in the restart directory -->
        <Parameter name="Restart" type="bool"  value="false"/>
        <Parameter name="Restart directory" type="string" value="restartCheckpoints"/>
        <Parameter name="Time step" type="double"   	value="0.05"/>
        <Parameter name="Import history" type="bool"  value="false"/>

        <!-- Phase 2 compares its solution at its final time with the checkpoint of
             phase 1 at that time -->
        <Parameter name="Final time compare" type="double" value="0.09"/>
        <Parameter name="Restart tolerance" type="double" value="1.e-8"/> <!-- relative 2-norm of the difference -->


        <Parameter name="BDF" type="int" value="1"/>
        <Parameter name="Class" type="string" value="Multistep"/> <!-- External, Multistep-->
        <Parameter name="Timestepping type" type="string" value="non-adaptive"/><!--non-adaptive,adaptive:not working for BDF2-->
    
        <Parameter name="Final time" type="double" value="0.15"/>
        <Parameter name="dt" type="double" value="0.05"/>
        <Parameter name="beta" type="double" value="0.25"/> <!-- newmark method parameter-->
        <Parameter name="gamma" type="double" value="0.5"/> <!-- newmark method parameter-->
        <ParameterList name="Timestepping Intervalls">
            <Parameter name="Number of Segments" type="int" value="3"/>
            <ParameterList name="1">
                <Parameter name="Start Time" type="double" value="0."/>
                <Parameter name="dt" type="double" value="0.05"/>
                <Parameter name="Adaptive" type="bool" value="false"/>
            </ParameterList>
            <ParameterList name="2">
                <Parameter name="Start Time" type="double" value="0.05"/>
                <Parameter name="dt" type="double" value="0.05"/>
                <Parameter name="Minimum dt" type="double" value="0.005"/>
            </ParameterList>
            <ParameterList name="3">
                <Parameter name="Start Time" type="double" value="0.1"/>
                <Parameter name="dt" type="double" value="0.05"/>
                <Parameter name="Adaptive" type="bool" value="false"/>
            </ParameterList>
        </ParameterList>
    </ParameterList>
</ParameterList>
