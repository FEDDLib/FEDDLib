<ParameterList name="SCI">
  <ParameterList name="Parameter Solid">
    <Parameter name="Number of Materials" type="int" value="1" />
    <ParameterList name="1">
      <!-- Volume Flag 15 matches THIS mesh's single volume region (see
           generate_feddlib_mesh.py); it is not artery_dan's flag 16
           ("Media"); every parameter value below it, though, is copied
           verbatim from artery_dan's own "Media" domain (materialParameters
           _dan.xml, ParameterList "2", Volume Flag 16), per instruction:
           this is a single-domain test, so it uses the Media domain's real,
           previously-calibrated parameters rather than a hand-picked mix. -->
      <Parameter name="Volume Flag" type="int" value="15" />
      <Parameter name="Material Model" type="string" value="SCI_SMC_Active_Growth_Reorientation" />
      <Parameter name="Neo-Hooke Modell" type="int" value="1" />
      <Parameter name="E" type="double" value="0.38" />
      <Parameter name="E1" type="double" value="0.30" />
      <Parameter name="c1" type="double" value="0.25" />
      <Parameter name="Poisson Ratio" type="double" value="0.49" />
      <Parameter name="Fibre angle" type="double" value="30." />
      <Parameter name="LambdaC50" type="double" value="1.2" />
      <Parameter name="Gamma3Max" type="double" value="0.9" />
      <Parameter name="LambdaBarCDotMax" type="double" value="0.0443" />
      <Parameter name="LambdaBarCDotMin" type="double" value="-0.0443" />
      <Parameter name="Gamma2" type="double" value="50.0" />
      <Parameter name="Gamma1Max" type="double" value="0.5131" />
      <Parameter name="Gamma1Min" type="double" value="0.07797910389823641" />
      <Parameter name="Gamma3Min" type="double" value="0.13677878297366072" />
      <Parameter name="Eta" type="double" value="0.1624" />
      <Parameter name="Ca50" type="double" value="0.4" />
      <Parameter name="K3" type="double" value="0.134" />
      <Parameter name="K4" type="double" value="0.00166" />
      <Parameter name="K7" type="double" value="0.66e-4" />
      <Parameter name="Kappa" type="double" value="103.783" />
      <Parameter name="Beta1" type="double" value="0.00100" />
      <Parameter name="MuA" type="double" value="11.857" />
      <Parameter name="Beta2" type="double" value="26.68" />
      <Parameter name="Alpha1" type="double" value="11.52507" />
      <Parameter name="Alpha2" type="double" value="151.73775" />
      <Parameter name="Alpha3" type="double" value="2.75662" />
      <Parameter name="Alpha4" type="double" value="1.27631" />
      <Parameter name="Alpha5" type="double" value="3.08798" />
      <Parameter name="Gamma6" type="double" value="1.5" />
      <Parameter name="LambdaP50" type="double" value="1.0" />
      <Parameter name="KDotMin" type="double" value="-0.0010694" />
      <Parameter name="Zeta1" type="double" value="10." />
      <Parameter name="KDotMax" type="double" value="0.0009735" />
      <Parameter name="Gamma4" type="double" value="200." />
      <Parameter name="LambdaBarDotPMin" type="double" value="-0.0002323" />
      <Parameter name="LambdaBarDotPMax" type="double" value="0.0000699" />
      <Parameter name="Gamma5" type="double" value="50." />
      <Parameter name="Zeta2" type="double" value="100." />
      <Parameter name="DeltaLambdaBarPMin" type="double" value="-1.e-5" />
      <Parameter name="C50" type="double" value="0.6673453235597163" />
      <Parameter name="D0" type="double" value="7.e-3" />
      <Parameter name="M" type="double" value="0." />
      <Parameter name="ActiveStartTime" type="double" value="20.0" />
      <Parameter name="kEtaPlus" type="double" value="0.001" />
      <Parameter name="mEtaPlus" type="double" value="5.0" />
      <Parameter name="KThetaPlus" type="double" value="1.e-5" />
      <Parameter name="KThetaMinus" type="double" value="1.e-5" />
      <Parameter name="MThetaPlus" type="double" value="3.0" />
      <Parameter name="MThetaMinus" type="double" value="3.0" />
      <Parameter name="ThetaPlus1" type="double" value="1.00506" />
      <Parameter name="ThetaPlus2" type="double" value="1.0206" />
      <Parameter name="ThetaPlus3" type="double" value="1.11992" />
      <Parameter name="ThetaMinus1" type="double" value="0.98" />
      <Parameter name="ThetaMinus2" type="double" value="0.98" />
      <Parameter name="ThetaMinus3" type="double" value="0.98" />
      <Parameter name="KMin" type="double" value="0.015" />
      <!-- Media's own growthDirectionBool is 1, kept as-is (copied
           verbatim); it is inert here regardless since growthBool is 0
           (growthDirectionBool only selects which anisotropy direction
           growth accumulates along, and no growth accumulates). ActiveBool,
           growthBool and reorientationBool are 0, matching Media and this
           being a purely passive, load-driven case. -->
      <Parameter name="ActiveBool" type="double" value="0" />
      <Parameter name="growthBool" type="double" value="0" />
      <Parameter name="reorientationBool" type="double" value="0" />
      <Parameter name="growthDirectionBool" type="double" value="1" />
      <Parameter name="kFiberDistribution" type="double" value="0.1333333333334" />
      <Parameter name="P" type="double" value="2.9580835205796716" />
      <Parameter name="Density" type="double" value="1.e0" />
      <Parameter name="PostProcessingType" type="double" value="1." />
      <Parameter name="PostProcessingPower" type="double" value="1." />
      <!-- Media's own Active/Growth segments (copied from
           materialParameters_dan.xml) all start at t=20.0 or later, well
           clear of this simulation's Final time=1.0.
           Media's Reorientation segments are 1.0-20.0, 220-240, 840-860;
           the FIRST one starts exactly at this simulation's own Final
           time (1.0), which would make reorientationBool_ flip to 1 on
           the very last step (segment-membership uses >=/approxEqual on
           the start bound). That segment is dropped here (only the other
           two, clearly out of range, are kept) so
           activeBool_/growthBool_/reorientationBool_ deterministically
           resolve to 0 for the whole run, exactly as the domain-data
           flags above already say, with no edge-of-range false trigger. -->
      <ParameterList name="Timestepping Intervalls Active">
        <Parameter name="Number of Segments" type="int" value="3" />
        <ParameterList name="1">
          <Parameter name="Start Time" type="double" value="20.0" />
          <Parameter name="End Time" type="double" value="220.0" />
        </ParameterList>
        <ParameterList name="2">
          <Parameter name="Start Time" type="double" value="240.0" />
          <Parameter name="End Time" type="double" value="540.0" />
        </ParameterList>
        <ParameterList name="3">
          <Parameter name="Start Time" type="double" value="860.0" />
          <Parameter name="End Time" type="double" value="1500.0" />
        </ParameterList>
      </ParameterList>
      <ParameterList name="Timestepping Intervalls Growth">
        <Parameter name="Number of Segments" type="int" value="1" />
        <ParameterList name="1">
          <Parameter name="Start Time" type="double" value="540.0" />
          <Parameter name="End Time" type="double" value="840.0" />
        </ParameterList>
      </ParameterList>
      <ParameterList name="Timestepping Intervalls Reorientation">
        <Parameter name="Number of Segments" type="int" value="2" />
        <ParameterList name="1">
          <Parameter name="Start Time" type="double" value="220.0" />
          <Parameter name="End Time" type="double" value="240.0" />
        </ParameterList>
        <ParameterList name="2">
          <Parameter name="Start Time" type="double" value="840.0" />
          <Parameter name="End Time" type="double" value="860.0" />
        </ParameterList>
      </ParameterList>
    </ParameterList>
  </ParameterList>
</ParameterList>
